@page "/teacher"
@layout BiologyLayout
@using BlazorAppTestSchool.Data
@using static BlazorAppTestSchool.Data.BiologyAttemptReport
@inject BiologyAttemptStore AttemptStore
@inject IWebHostEnvironment Environment
@inject ILogger<Teacher> Logger

@if (Preview)
{
    <BiologyTest @rendermode="InteractiveServer" />
}
else
{
    <PageTitle>Вчитель | Шкільна лабораторія</PageTitle>

    <section class="school-lab" aria-labelledby="teacher-heading">
        <h1 id="teacher-heading">Сторінка вчителя</h1>
        <p>Біологія · 7 клас · 12 завдань</p>
        <a class="btn btn-outline-secondary mb-4" href="teacher?preview=true">Переглянути контрольну</a>

        @if (!canViewReports)
        {
            <p>Роботи учнів доступні в локальному режимі розробки.</p>
        }
        else if (message is not null)
        {
            <p class="text-danger" role="alert">@message</p>
            <a href="@ListUrl(CurrentPage)">До списку робіт</a>
        }
        else if (report is { } result)
        {
            <section aria-labelledby="report-heading">
                <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
                    <a href="@ListUrl(CurrentPage)">До списку робіт</a>
                    <a class="btn btn-primary" href="@($"teacher/reports/{Attempt}/word")" data-enhance-nav="false">
                        Завантажити Word
                    </a>
                </div>
                <h2 id="report-heading" class="h4">@result.StudentName · @result.Grade клас</h2>
                @if (result.Questions.Any(question => question.Points is null))
                {
                    <p>Попередня оцінка: <strong>@result.Score з @result.Questions.Length</strong>.
                        Відповідь із поясненням очікує перевірки.</p>
                }
                else
                {
                    <p>Оцінка: <strong>@result.Score з @result.Questions.Length</strong>.</p>
                }
                <p>Загальний час: <strong>@FormatDuration(result.Duration)</strong>.</p>

                <ol class="list-group list-group-numbered mt-3">
                    @foreach (var question in result.Questions)
                    {
                        <li class="list-group-item d-flex gap-2">
                            <div class="flex-grow-1">
                                <h3 class="h6">@question.Question</h3>
                                <p class="mb-2 text-break" style="white-space: pre-wrap">@(question.Answer ?? "Без відповіді")</p>
                                <p class="mb-0">
                                    <strong>@(question.Points switch { 1 => "1 бал", 0 => "0 балів", _ => "Очікує перевірки" })</strong>
                                    · @FormatDuration(question.Duration)
                                    @if (question.TimeExpired)
                                    {
                                        <span>· Час вичерпано</span>
                                    }
                                </p>
                            </div>
                        </li>
                    }
                </ol>
            </section>
        }
        else
        {
            <h2 class="h4">Роботи учнів</h2>
            @if (attempts.Length == 0)
            {
                <p>На цій сторінці ще немає зданих робіт.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Учень</th>
                                <th scope="col">Клас</th>
                                <th scope="col">Оцінка</th>
                                <th scope="col">Час</th>
                                <th scope="col">Здано</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in attempts)
                            {
                                <tr>
                                    <th scope="row"><a href="@ReportUrl(item.Id)">@item.StudentName</a></th>
                                    <td>@item.Grade</td>
                                    <td>
                                        @item.Score з @item.MaxScore
                                        @if (item.PendingReview)
                                        {
                                            <span class="d-block small">Попередня</span>
                                        }
                                    </td>
                                    <td>@FormatDuration(item.Duration)</td>
                                    <td>@(item.SubmittedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (CurrentPage > 1 || hasMore)
            {
                <nav class="d-flex gap-3" aria-label="Сторінки робіт">
                    @if (CurrentPage > 1)
                    {
                        <a href="@ListUrl(CurrentPage - 1)">Попередня сторінка</a>
                    }
                    @if (hasMore)
                    {
                        <a href="@ListUrl(CurrentPage + 1)">Наступна сторінка</a>
                    }
                </nav>
            }
        }
    </section>
}

@code {
    [SupplyParameterFromQuery] private bool Preview { get; set; }
    [SupplyParameterFromQuery(Name = "attempt")] private string? Attempt { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private string? PageNumber { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private BiologyAttemptReport? report;
    private BiologyAttemptSummary[] attempts = [];
    private string? message;
    private bool canViewReports;
    private bool hasMore;
    private int CurrentPage => int.TryParse(PageNumber, out var page) && page is > 0 and <= int.MaxValue / BiologyAttemptStore.PageSize ? page : 1;

    protected override async Task OnParametersSetAsync()
    {
        if (Preview)
        {
            return;
        }

        if (HttpContext is { } requestContext)
        {
            requestContext.Response.Headers.CacheControl = "no-store";
        }

        canViewReports = TeacherReportAccess.CanView(Environment, HttpContext);
        if (!canViewReports || HttpContext is not { } context)
        {
            return;
        }

        try
        {
            if (Attempt is null)
            {
                (attempts, hasMore) = await AttemptStore.ListAsync(CurrentPage, context.RequestAborted);
                return;
            }

            report = Guid.TryParse(Attempt, out var attemptId)
                ? await AttemptStore.FindAsync(attemptId, context.RequestAborted)
                : null;
            if (report is null)
            {
                message = "Роботу не знайдено.";
            }
        }
        catch (Exception exception) when (!context.RequestAborted.IsCancellationRequested)
        {
            Logger.LogError(exception, "Could not load biology test reports.");
            message = "Роботи учнів тимчасово недоступні.";
        }
    }

    private static string ListUrl(int page) => page <= 1 ? "teacher" : $"teacher?page={page}";
    private string ReportUrl(Guid attemptId) => $"teacher?attempt={attemptId:N}&page={CurrentPage}";
}