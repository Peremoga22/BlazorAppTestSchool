@page "/biology-test"
@layout BiologyLayout
@rendermode InteractiveServer
@using BlazorAppTestSchool.Data
@using BlazorAppTestSchool.Data.Testing
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedSessionStorage ProfileStorage
@inject TestDefinitionStore TestStore
@inject BiologyAttemptStore AttemptStore
@inject NavigationManager Navigation
@inject ILogger<TestPage> Logger

@if (loadError is not null)
{
    <section class="school-lab" aria-labelledby="load-error-heading">
        <h1 id="load-error-heading">Тест не відкрився</h1>
        <p role="alert">@loadError</p>
        <a class="btn btn-outline-secondary" href="">На головну</a>
    </section>
}
else if (profile is not { } participant)
{
    <p role="status">Завантажуємо профіль…</p>
}
else if (!testReady)
{
    <p role="status">Завантажуємо контрольну…</p>
}
else if (!canStart)
{
    <section class="school-lab school-lab-intro" aria-labelledby="already-taken-heading">
        <p class="school-lab-subject">@participant.LastName · @participant.Grade клас</p>
        <h1 id="already-taken-heading">Контрольну вже здано</h1>
        <p>
            Прізвище @participant.LastName вже є серед робіт з предмета @participant.Subject (@participant.Grade клас).
            Повернутися до тесту і пройти його вдруге не можна.
        </p>
        <a class="btn btn-outline-secondary" href="">На головну</a>
    </section>
}
else if (variants.Length == 0)
{
    <section class="variant-board" aria-labelledby="no-test-heading">
        <header class="variant-board-head">
            <p class="school-lab-subject">@participant.LastName · @participant.Grade клас</p>
            <h1 id="no-test-heading">Тест ще не готовий</h1>
            <p>Учитель ще не відкрив контрольну «@participant.Subject» для @participant.Grade класу. Спробуй пізніше.</p>
        </header>
        <a class="btn btn-outline-secondary" href="">На головну</a>
    </section>
}
else if (variants.Length > 1 && test is null)
{
    <section class="variant-board" aria-labelledby="pick-variant-heading">
        <header class="variant-board-head">
            <div>
                <p class="school-lab-subject">@participant.Subject · @participant.Grade клас</p>
                <h1 id="pick-variant-heading">Обери варіант контрольної</h1>
                <p>@participant.LastName, учитель підготував @variants.Length @VariantWord(variants.Length). Після вибору змінити його не вийде.</p>
            </div>
            <dl class="variant-stats">
                <div>
                    <dt>Учень</dt>
                    <dd>@participant.LastName</dd>
                </div>
                <div>
                    <dt>Клас</dt>
                    <dd>@participant.Grade</dd>
                </div>
                <div>
                    <dt>Варіанти</dt>
                    <dd>@variants.Length</dd>
                </div>
            </dl>
        </header>
        <div class="variant-grid">
            @for (var index = 0; index < variants.Length; index++)
            {
                var variant = variants[index];
                <a class="variant-card" href="@($"biology-test?test={variant.Id:N}")">
                    <span class="variant-card-kicker">Варіант @(index + 1)</span>
                    <h2>@variant.Title</h2>
                    <p>@variant.Subject@(variant.Grade is { } grade ? $" · {grade} клас" : null)</p>
                    <span class="variant-card-go">Почати</span>
                </a>
            }
        </div>
        <p class="variant-board-note">Один учень — один варіант. Після натискання «Почати» контрольна відкриється одразу.</p>
    </section>
}
else
{
    <TestRunner Test="test!" TestId="activeTestId" Participant="participant" />
}

@code {
    [SupplyParameterFromQuery(Name = "test")] private string? SelectedTestId { get; set; }

    private BiologyProfile? profile;
    private TestDefinitionSummary[] variants = [];
    private TestDefinitionModel? test;
    private Guid? activeTestId;
    private bool testReady;
    private bool canStart = true;
    private string? loadError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var saved = await ProfileStorage.GetAsync<BiologyProfile>(BiologyProfile.StorageKey);
            if (!saved.Success || saved.Value is not { IsValid: true } participant)
            {
                Navigation.NavigateTo("", replace: true);
                return;
            }

            profile = participant;
            await RefreshTestAsync(participant);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not open the biology test.");
            loadError = "Не вдалося відкрити контрольну. Онови сторінку ще раз.";
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Re-runs when ?test= changes via a same-page link click (picking a variant);
        // the profile itself is only loaded once, after the first render, above.
        if (profile is { } participant)
        {
            try
            {
                await RefreshTestAsync(participant);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Could not open the biology test.");
                loadError = "Не вдалося відкрити контрольну. Онови сторінку ще раз.";
            }
        }
    }

    private async Task RefreshTestAsync(BiologyProfile participant)
    {
        testReady = false;
        StateHasChanged();

        canStart = await AttemptStore.CanStartAsync(participant.LastName, participant.Grade, participant.Subject);
        if (!canStart)
        {
            test = null;
            activeTestId = null;
            testReady = true;
            StateHasChanged();
            return;
        }

        variants = await TestStore.ListActiveAsync(participant.Subject, participant.Grade);

        var chosenId = SelectedTestId is { Length: > 0 } id && Guid.TryParse(id, out var guid) ? guid : (Guid?)null;
        activeTestId = variants.Length switch
        {
            1 => variants[0].Id,
            > 1 when chosenId is { } selected && variants.Any(variant => variant.Id == selected) => selected,
            _ => null
        };
        test = activeTestId is { } testId ? await TestStore.GetAsync(testId) : null;

        testReady = true;
        StateHasChanged();
    }

    private static string VariantWord(int count)
    {
        var teen = count % 100;
        if (teen is >= 11 and <= 14)
        {
            return "варіантів";
        }

        return (count % 10) switch
        {
            1 => "варіант",
            2 or 3 or 4 => "варіанти",
            _ => "варіантів"
        };
    }
}
